# Environment Variables for Enterprise AI Data Analyst Agent
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
PORT=8888

# Local SQLite defaults to database/minhan_app.sqlite3
# Set this to a shared PostgreSQL URL for deployments
DATABASE_URL=
# Required for Vercel deployments; use a long random secret
SESSION_SECRET=
# Optional local database override
APP_DB_PATH=
